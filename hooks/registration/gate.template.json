{
  "_generated_by": "filmkit-doctor --install \u2014 do not hand-edit; __GATE_PATH__ is a placeholder",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__higgsfield__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__GATE_PATH__/gate.py\"",
            "timeout": 30,
            "statusMessage": "filmkit: checking preflight receipt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__GATE_PATH__/session_start.py\"",
            "timeout": 30,
            "statusMessage": "filmkit: loading project state"
          }
        ]
      }
    ]
  }
}
