{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__higgsfield__(generate|upscale|outpaint|reframe|motion_control|remove_background).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEX_PLUGIN_ROOT/hooks/gate.py\"",
            "timeout": 30,
            "statusMessage": "filmkit: checking preflight receipt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEX_PLUGIN_ROOT/hooks/session_start.py\"",
            "timeout": 30,
            "statusMessage": "filmkit: loading project state"
          }
        ]
      }
    ]
  }
}
